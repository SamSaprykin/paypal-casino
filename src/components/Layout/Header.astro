---
import { ChevronDown, Menu, X } from "@lucide/astro";
import Logo from "./Logo.astro";
import CountrySelector from "./CountrySelector.astro";
import HeaderNavIcon from "./HeaderNavIcon.astro";
import {
  ROOT_WEBSITE_LOCALE,
  resolveHeaderNav,
  type WebsiteLocaleKey,
} from "../../lib/content";

interface Props {
  locale?: WebsiteLocaleKey;
  /**
   * Per-locale CMS slugs for the current page. Forwarded to the country selector so
   * switching locales lands on the equivalent page (not just the home).
   */
  localizedSlugs?: Partial<Record<WebsiteLocaleKey, string>>;
  localeHrefs?: Partial<Record<WebsiteLocaleKey, string>>;
}

const { locale = ROOT_WEBSITE_LOCALE, localizedSlugs, localeHrefs } =
  Astro.props as Props;

const { labels, homeHref, categories } = await resolveHeaderNav(locale);
---

<nav
  class="fixed top-4 left-1/2 -translate-x-1/2 w-[calc(100vw-2rem)] lg:w-[calc(100vw-10rem)] max-w-[100rem] mx-auto bg-blue-800/95 backdrop-blur-xs text-white shadow-xl rounded-2xl z-50 transition-all duration-300"
  data-header-mega
>
  <div class="mx-auto px-4 lg:px-8 w-full">
    <div class="flex items-center justify-between py-2 lg:py-4 relative min-h-[60px] gap-4">
      <a href={homeHref} class="flex items-center group shrink-0">
        <Logo />
      </a>

      <div class="hidden lg:flex items-center gap-1 absolute left-1/2 -translate-x-1/2">
        <a
          href={homeHref}
          class="px-3 py-2 text-sm font-medium text-white/90 hover:text-white rounded-lg hover:bg-white/10 transition"
        >
          {labels.onlineCasino}
        </a>

        {
          categories.map((cat) => (
            <div class="group/cat relative">
              <button
                type="button"
                class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-white/90 hover:text-white rounded-lg hover:bg-white/10 transition"
                aria-haspopup="true"
              >
                {cat.title}
                <ChevronDown class="w-4 h-4 transition-transform group-hover/cat:rotate-180" />
              </button>

              <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible pointer-events-none group-hover/cat:opacity-100 group-hover/cat:visible group-hover/cat:pointer-events-auto transition-all duration-200 z-50 min-w-[16rem] w-max max-w-[28rem]">
                <div
                  class={`grid gap-1 p-2 rounded-xl bg-white shadow-2xl ring-1 ring-black/5 ${cat.items.length > 1 ? "grid-cols-2" : "grid-cols-1"}`}
                >
                  {cat.items.map((item) => (
                    <a
                      href={item.href}
                      class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-blue-50 text-gray-800 transition whitespace-nowrap"
                    >
                      <HeaderNavIcon name={item.icon} />
                      <span class="text-sm font-semibold">{item.label}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="flex items-center gap-2 lg:gap-3 shrink-0">
        <CountrySelector
          localizedSlugs={localizedSlugs}
          localeHrefs={localeHrefs}
          currentLocale={locale}
        />
        <button
          id="menu-toggle"
          type="button"
          class="lg:hidden text-white focus:outline-none"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span data-menu-icon-open>
            <Menu size={24} />
          </span>
          <span data-menu-icon-close class="hidden">
            <X size={24} />
          </span>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="lg:hidden overflow-hidden transition-all duration-500 ease-in-out max-h-0 opacity-0"
    >
      <div class="pb-4 mt-2 px-2 flex flex-col gap-1">
        <a
          href={homeHref}
          class="block px-3 py-2.5 text-sm font-medium text-white rounded-lg hover:bg-white/10"
        >
          {labels.onlineCasino}
        </a>
        {
          categories.map((cat) => (
            <div data-accordion>
              <button
                type="button"
                class="flex w-full items-center justify-between px-3 py-2.5 text-sm font-medium text-white rounded-lg hover:bg-white/10"
                data-accordion-trigger
                aria-expanded="false"
              >
                {cat.title}
                <ChevronDown
                  class="w-4 h-4 transition-transform"
                  data-accordion-chevron
                />
              </button>
              <ul
                class="overflow-hidden max-h-0 opacity-0 transition-all duration-300 pl-2"
                data-accordion-panel
              >
                {cat.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="flex items-center gap-3 px-3 py-2 text-sm text-white/90 rounded-lg hover:bg-white/10"
                    >
                      <HeaderNavIcon name={item.icon} compact />
                      <span>{item.short || item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    const nav = document.querySelector("[data-header-mega]");
    if (!nav || nav.dataset.initialized === "1") return;
    nav.dataset.initialized = "1";

    const toggleBtn = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    if (!toggleBtn || !mobileMenu) return;

    let isOpen = false;
    const iconOpen = toggleBtn.querySelector("[data-menu-icon-open]");
    const iconClose = toggleBtn.querySelector("[data-menu-icon-close]");

    const openMenu = () => {
      isOpen = true;
      mobileMenu.style.opacity = "1";
      // Measure collapsed content, animate open, then unlock height so
      // accordion expands are not clipped by a fixed max-height.
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
      const unlock = (event) => {
        if (event.propertyName !== "max-height" || !isOpen) return;
        mobileMenu.style.maxHeight = "none";
        mobileMenu.removeEventListener("transitionend", unlock);
      };
      mobileMenu.addEventListener("transitionend", unlock);
      toggleBtn.setAttribute("aria-expanded", "true");
      iconOpen?.classList.toggle("hidden", true);
      iconClose?.classList.toggle("hidden", false);
    };

    const closeMenu = () => {
      isOpen = false;
      // Snapshot pixel height before collapsing (needed when max-height is "none").
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
      void mobileMenu.offsetHeight;
      mobileMenu.style.maxHeight = "0";
      mobileMenu.style.opacity = "0";
      toggleBtn.setAttribute("aria-expanded", "false");
      iconOpen?.classList.toggle("hidden", false);
      iconClose?.classList.toggle("hidden", true);
    };

    toggleBtn.addEventListener("click", () => {
      if (isOpen) closeMenu();
      else openMenu();
    });

    mobileMenu.querySelectorAll("[data-accordion]").forEach((accordion) => {
      const trigger = accordion.querySelector("[data-accordion-trigger]");
      const panel = accordion.querySelector("[data-accordion-panel]");
      const chevron = accordion.querySelector("[data-accordion-chevron]");
      if (!trigger || !panel) return;

      let open = false;
      trigger.addEventListener("click", () => {
        open = !open;
        panel.style.maxHeight = open ? panel.scrollHeight + "px" : "0";
        panel.style.opacity = open ? "1" : "0";
        trigger.setAttribute("aria-expanded", open ? "true" : "false");
        chevron?.classList.toggle("rotate-180", open);
        // Drop the fixed open-height so accordion growth isn't clipped.
        if (isOpen) mobileMenu.style.maxHeight = "none";
      });
    });
  })();
</script>
