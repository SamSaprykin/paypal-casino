---
import type { PageSection } from "../../lib/content";
import type { WebsiteLocaleKey } from "../../lib/content";

import ContentSection from "./sections/ContentSection.astro";
import CasinoListSection from "./sections/CasinoListSection.astro";
import FaqSection from "./sections/FaqSection.astro";
import HowToSection from "./sections/HowToSection.astro";
import BonusesListSection from "./sections/BonusesListSection.astro";
import ImageSection from "./sections/ImageSection.astro";
import MethodAvailabilitySection from "./sections/MethodAvailabilitySection.astro";
import BonusCalculatorSection from "./sections/BonusCalculatorSection.astro";
import WhatPeopleSay from "./WhatPeopleSay.astro";
import DenmarkMarketNotice from "./DenmarkMarketNotice.astro";
import Disclosure from "./Disclosure.astro";

interface Props {
  sections: PageSection[];
  locale?: WebsiteLocaleKey;
  /** When false, skip the Denmark tax/ROFUS/AML notice. Default true. */
  showDenmarkMarketNotice?: boolean;
  /** When false, skip the hardcoded compliance banner (rare). Default true. */
  showDisclosure?: boolean;
}

const {
  sections,
  locale,
  showDenmarkMarketNotice = true,
  showDisclosure = true,
} = Astro.props;
---

<div class="website-page-sections flex flex-col bg-transparent py-4">
  {
    sections.map((section) => {
      switch (section.kind) {
        case "casinoList":
          return <CasinoListSection section={section} locale={locale} />;
        case "faqComponent":
          return <FaqSection section={section} />;
        case "contentComponent":
          return <ContentSection section={section} locale={locale} />;
        case "howTo":
          return <HowToSection section={section} locale={locale} />;
        case "bonusesList":
          return <BonusesListSection section={section} locale={locale} />;
        case "image":
          return <ImageSection section={section} locale={locale} />;
        case "methodAvailability":
          return (
            <MethodAvailabilitySection section={section} locale={locale} />
          );
        case "bonusCalculator":
          return (
            <BonusCalculatorSection section={section} locale={locale} />
          );
        case "whatPeopleSay":
          return section.quotes?.length ? (
            <WhatPeopleSay section={section} />
          ) : null;
        default:
          return null;
      }
    })
  }
  {
    showDenmarkMarketNotice && locale === "denmark" ? (
      <DenmarkMarketNotice />
    ) : null
  }
  {
    showDisclosure ? (
      <Disclosure locale={locale} class="rounded-b-xl" />
    ) : null
  }
</div>
