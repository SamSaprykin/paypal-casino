---
import AuthorContactLinks from "./AuthorContactLinks.astro";
import type { PageAuthorRef } from "../../lib/data/authors";
import type { WebsitePageCopy } from "../../lib/i18n/copies/website-page";

interface Props {
  copy: WebsitePageCopy;
  createdAt?: string;
  updatedAt?: string;
  createdDisplay?: string | null;
  updatedDisplay?: string | null;
  addedBy?: PageAuthorRef;
  reviewedBy?: PageAuthorRef;
  hideAuthors?: boolean;
}

const {
  copy,
  createdAt,
  updatedAt,
  createdDisplay,
  updatedDisplay,
  addedBy,
  reviewedBy,
  hideAuthors = false,
} = Astro.props as Props;

const showDates = Boolean(createdAt || updatedAt);
const showAuthors = !hideAuthors && Boolean(addedBy || reviewedBy);
const show = showDates || showAuthors;

type BylineAuthor = {
  author: PageAuthorRef;
  label: string;
  tone: "blue" | "slate";
};

const bylineAuthors: BylineAuthor[] = [];
if (addedBy) {
  bylineAuthors.push({ author: addedBy, label: copy.addedBy, tone: "blue" });
}
if (reviewedBy) {
  bylineAuthors.push({
    author: reviewedBy,
    label: copy.reviewedBy,
    tone: "slate",
  });
}

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? "")
    .join("");
}

---

{
  show ? (
    <div class="flex flex-col gap-2 border-b border-slate-200/70 bg-white/60 px-3 py-2 font-roboto text-[11px] leading-snug text-slate-600 sm:gap-3 sm:px-4 sm:py-3 sm:text-xs sm:flex-row sm:items-start sm:justify-between">
      {/* Dates first on mobile to keep the top compact; authors sit below */}
      {showDates ? (
        <div class="order-1 flex shrink-0 flex-wrap items-baseline gap-x-3 gap-y-0.5 sm:order-2 sm:flex-col sm:items-end sm:gap-0 sm:pt-0.5 sm:text-right">
          {updatedAt ? (
            <div>
              <span class="font-semibold text-slate-700">{copy.updated}</span>{" "}
              <time
                class="font-semibold text-slate-900"
                datetime={updatedAt}
              >
                {updatedDisplay}
              </time>
            </div>
          ) : null}
          {createdAt ? (
            <div class:list={{ "sm:mt-1": Boolean(updatedAt) }}>
              <span class="font-medium text-slate-500">{copy.created}</span>{" "}
              <time datetime={createdAt}>{createdDisplay}</time>
            </div>
          ) : null}
        </div>
      ) : null}

      {showAuthors ? (
        <div class="order-2 flex min-w-0 flex-1 flex-row flex-wrap items-start gap-x-3 gap-y-1.5 border-t border-slate-200/60 pt-2 sm:order-1 sm:gap-x-6 sm:gap-y-3 sm:border-t-0 sm:pt-0">
          {bylineAuthors.map(({ author, label, tone }) => (
            <div class="flex min-w-0 max-w-full flex-1 basis-[calc(50%-0.375rem)] items-center gap-1.5 sm:max-w-none sm:flex-none sm:basis-auto sm:items-start sm:gap-2.5">
              <div
                class:list={[
                  "relative h-6 w-6 shrink-0 overflow-hidden rounded-full sm:h-9 sm:w-9",
                  tone === "blue"
                    ? "bg-blue-100 text-blue-800"
                    : "bg-slate-200 text-slate-700",
                ]}
              >
                <img
                  src={author.image}
                  alt=""
                  width="36"
                  height="36"
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                  onerror="this.classList.add('hidden');var el=this.nextElementSibling;if(el){el.classList.remove('hidden');el.classList.add('flex')}"
                />
                <span
                  class="absolute inset-0 hidden items-center justify-center text-[9px] font-bold sm:text-[11px]"
                  aria-hidden="true"
                >
                  {initials(author.name)}
                </span>
              </div>
              <div class="min-w-0">
                <div class="font-medium text-slate-500">{label}</div>
                <div class="truncate font-semibold text-slate-800">
                  {author.name}
                </div>
                {author.role ? (
                  <div class="hidden truncate text-slate-500 sm:block">
                    {author.role}
                  </div>
                ) : null}
                <AuthorContactLinks
                  author={author}
                  class="mt-0.5 hidden sm:mt-1.5 sm:flex"
                />
              </div>
            </div>
          ))}
        </div>
      ) : null}
    </div>
  ) : null
}
