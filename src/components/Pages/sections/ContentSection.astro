---
import { ContentComponent } from "../ContentComponent.jsx";
import type { ContentSection, WebsiteLocaleKey } from "../../../lib/content";
import { ROOT_WEBSITE_LOCALE } from "../../../lib/content";
import {
  CONTENT_FRESHNESS_COPY,
  localeIdForWebsiteLocale,
} from "../../../lib/i18n";

interface Props {
  section: ContentSection;
  locale?: WebsiteLocaleKey;
}

const { section, locale = ROOT_WEBSITE_LOCALE } = Astro.props;
const markdown = section.bodyMarkdown ?? "";
const sectionDomId = `content-section-${section.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
const localeId = localeIdForWebsiteLocale(locale);
const freshnessCopy = CONTENT_FRESHNESS_COPY[localeId];
---

{
  markdown.trim() ? (
    <section
      id={sectionDomId}
      class="scroll-mt-24 border-b border-slate-200/60 last:border-b-0"
    >
      <div class="p-4 sm:p-8">
        <ContentComponent
          content={markdown}
          firstBonus={null}
          spaceTop={0}
          spaceBottom={0}
          localeId={localeId}
          localeTag={freshnessCopy.localeTag}
          freshnessLabels={freshnessCopy}
        />
      </div>
    </section>
  ) : null
}
