---
import LastUpdatedReact from "./LastUpdated.jsx";
import type { WebsiteLocaleKey } from "../../lib/content";
import { ROOT_WEBSITE_LOCALE } from "../../lib/content";
import { toIsoDateOnly, type ReviewCycle } from "../../lib/content/freshness";
import {
  CONTENT_FRESHNESS_COPY,
  localeIdForWebsiteLocale,
} from "../../lib/i18n";

interface Props {
  locale?: WebsiteLocaleKey;
  /** Last verified date (ISO or YYYY-MM-DD). Falls back to updatedAt. */
  date?: string;
  updatedAt?: string;
  reviewCycle?: ReviewCycle;
  nextReview?: string;
  class?: string;
}

const {
  locale = ROOT_WEBSITE_LOCALE,
  date,
  updatedAt,
  reviewCycle = "monthly",
  nextReview,
  class: className,
} = Astro.props as Props;

const copy = CONTENT_FRESHNESS_COPY[localeIdForWebsiteLocale(locale)];

const resolvedDate =
  date ||
  (updatedAt
    ? updatedAt.length >= 10
      ? updatedAt.slice(0, 10)
      : toIsoDateOnly(new Date(updatedAt))
    : undefined);
---

{
  resolvedDate ? (
    <div class:list={["px-4 sm:px-6", className]}>
      <LastUpdatedReact
        date={resolvedDate}
        reviewCycle={reviewCycle}
        nextReview={nextReview}
        localeTag={copy.localeTag}
        labels={copy}
      />
    </div>
  ) : null
}
